# .env.example
# Configuration for the 04uk.com Re-upload Bot
# Copy this file to .env and replace the placeholder values below with your actual credentials.

# Your username for 04uk.com
AD_USERNAME="YOUR_04UK_USERNAME"

# Your password for 04uk.com
AD_PASSWORD="YOUR_04UK_PASSWORD"

# A unique part of the title of the ad you want to re-upload
# Used to find the correct ad in your articles list
AD_PARTIAL_TITLE="PART_OF_YOUR_AD_TITLE"